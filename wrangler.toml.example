# 片段，不是完整部署配置。
# 把下面的 [[services]] 合并进现有的 abot-gateway wrangler 配置（或 Dashboard bindings）。
# 不要用本文件执行 wrangler deploy：线上的 D1 binding（DB）和路由必须原样保留。
# CI 部署用的是 wrangler.toml；本文件不会被自动部署。
#
# 网关与这 5 个后端必须在同一个 Cloudflare 账号。
# service 是 Worker 脚本名（原先 *.workers.dev 主机名的第一段）。

[[services]]
binding = "BACKEND_DATA"
service = "abot-data"

[[services]]
binding = "BACKEND_MAIL"
service = "resend-agent-mail-relay"

[[services]]
binding = "BACKEND_HEALTH"
service = "abot-health"

[[services]]
binding = "BACKEND_RULES"
service = "abot-rules"

[[services]]
binding = "BACKEND_SECRETS"
service = "abot-secrets"
